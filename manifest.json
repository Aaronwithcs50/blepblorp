{
  "manifest_version": 3,
  "name": "Docs Detail Refiner",
  "version": "1.0.0",
  "description": "Enhance the current Google Doc with refined writing and generated charts.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://docs.googleapis.com/*",
    "https://www.googleapis.com/*",
    "https://api.openai.com/*",
    "https://quickchart.io/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Docs Detail Refiner"
  }
}
